{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ESNext", "DOM", "ES2024"],
    "types": ["bun-types"],

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    "plugins": [
      {
        "name": "@effect/language-service",
        // These CLI and Bun entrypoint APIs remain unstable in stable Effect; package versions are pinned.
        "allowedUnstableApis": [
          "effect/cli",
          "@effect/platform-bun/BunServices#layer",
          "@effect/platform-bun/BunRuntime#runMain"
        ]
      }
    ]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".venv", "dist"]
}
