{
  "name": "@seanmozeik/tripwire",
  "version": "0.6.7",
  "description": "Opinionated hooks dispatcher for AI coding agents with configurable safety rules",
  "license": "MIT",
  "bin": {
    "tripwire": "./dist/tripwire",
    "tripwire-hook": "./dist/tripwire"
  },
  "files": [
    "dist",
    "package.json",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "check": "bun run format && bun run lint:fix && bun run typecheck",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --format agent --fix .",
    "prepare": "bunx effect-tsgo patch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "shell-quote": "1.10.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/tsgo": "0.38.0",
    "@seanmozeik/de-clank": "0.1.7",
    "bun-types": "1.4.0",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
